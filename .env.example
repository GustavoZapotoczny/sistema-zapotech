# Copie para .env (ou defina no sistema) e preencha. Nunca faça commit do .env.

# ---------- Backend ----------
# Development | Homologacao | Producao
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=zapotech;Username=zapotech;Password=zapotech
ConnectionStrings__Redis=localhost:6379

# Sentry: vazio = desligado
SENTRY_DSN=
# OpenTelemetry: vazio = não exporta (traces/métricas só em memória)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zapotech-api

# ---------- Web (variáveis VITE_ vão para o navegador: nada secreto aqui) ----------
VITE_API_URL=http://localhost:5080
VITE_SENTRY_DSN=
VITE_AMBIENTE=desenvolvimento

# ---------- Mobile (EXPO_PUBLIC_ vai para o app: nada secreto aqui) ----------
# No celular físico use o IP do seu PC na rede, ex.: http://192.168.0.10:5080
EXPO_PUBLIC_API_URL=http://localhost:5080
